# Forex Trading Signal Applet Environment Variables

# Gemini API Key (Server-side)
GEMINI_API_KEY=

# FCS Forex API Access Key
FCS_API_KEY=

# Paystack Secret Key (Server-side verification)
PAYSTACK_SECRET_KEY=

# Paystack Public Key (Client-side payments, must start with pk_test_ or pk_live_)
VITE_PAYSTACK_PUBLIC_KEY=
# Firebase System Backend Credentials
FIREBASE_SYSTEM_EMAIL=
FIREBASE_SYSTEM_PASSWORD=
